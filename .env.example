# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Laissez SSL activé par défaut (vérification du certificat).
# Base locale sans SSL en dev : DATABASE_SSL=false
# Certificat auto-signé (ex. Railway) : collez le CA dans DATABASE_CA_CERT
# DATABASE_SSL=false
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...

# ─── Authentification admin ───────────────────────────────────────────────────
# Générer le hash depuis la racine du projet :
#   node -e "console.log(require('bcryptjs').hashSync('VOTRE_MOT_DE_PASSE', 12))"
ADMIN_PASSWORD_HASH=
# Générer le secret de session :  openssl rand -base64 32
SESSION_SECRET=

# ─── Cloudinary (variables publiques, exposées au navigateur) ─────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── EmailJS (variables publiques, exposées au navigateur) ────────────────────
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ─── URL publique du site (SEO : canonical, hreflang, sitemap, Open Graph) ────
NEXT_PUBLIC_SITE_URL=https://scandellart.fr
# (adresse officielle — à définir sur Vercel pour Production ET Preview)

# ─── Traduction automatique (serveur uniquement — jamais de NEXT_PUBLIC) ─────
# Fournisseur : "claude" (par défaut) ou "deepl"
TRANSLATION_PROVIDER=claude
# Claude : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modèle Claude (optionnel — claude-sonnet-5-5 par défaut)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Modèle pour les longs textes (présentation, démarche) — claude-opus-5-5 par défaut
# TRANSLATION_MODEL_LONGFORM=claude-opus-5-5
# DeepL (si TRANSLATION_PROVIDER=deepl) : https://www.deepl.com/pro-api
# DEEPL_API_KEY=
# DEEPL_API_URL=https://api-free.deepl.com

# ─── Analyse IA d'une toile (serveur uniquement — réutilise ANTHROPIC_API_KEY) ─
# Active le bouton admin « Rédiger la présentation de cette toile »
ANALYSE_ENABLED=true
# Modèle d'analyse (optionnel — claude-sonnet-5-5 par défaut)
# ANALYSE_MODEL=claude-sonnet-5-5
